# Example only. Store real values outside the repository with mode 0600.

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8710

# Dedicated CUS Bot. Never reuse the working Telegram Agent token.
CUS_TELEGRAM_BOT_TOKEN=
CUS_BOT_WEBHOOK_SECRET=
CUS_ONBOARDING_TOKEN_KEY=
CUS_MINIAPP_DEEP_LINK_BASE=https://t.me/example_bot/example_app?startapp=
CUS_ALLOWED_FORUM_CHAT_IDS=-1001234567890
CUS_ONBOARDING_TOKEN_TTL_SECONDS=1800
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600

# Server-side provider and project storage.
AI_PROFILES_ROOT=/srv/ai-session-control-center/profiles
AI_PROJECT_ROOTS=/srv/projects
RUNTIME_DATA_ROOT=/var/lib/ai-session-control-center
AI_QUOTA_CACHE_ROOT=/var/lib/ai-session-control-center/quota_snapshots
PROJECT_BINDINGS_PATH=/var/lib/ai-session-control-center/project_bindings.json
PROJECT_SETTINGS_PATH=/var/lib/ai-session-control-center/project_settings_v2.json
RUNTIME_LAUNCH_SPECS_PATH=/var/lib/ai-session-control-center/runtime_launch_specs_v1.json
RUNTIME_CONTROL_PATH=/var/lib/ai-session-control-center/runtime_control_v1.json
CODEX_AUTH_ENROLLMENT_ROOT=/var/lib/ai-session-control-center/codex_auth_enrollments
CODEX_CAPABILITIES_CACHE_ROOT=/var/lib/ai-session-control-center/codex_capabilities

# AI Agent Runtime V1 connector.
RUNTIME_CONNECTOR_TIMEOUT_SECONDS=10
RUNTIME_RECONCILE_ENABLED=false
RUNTIME_RECONCILE_INTERVAL_SECONDS=15
RUNTIME_RECONCILE_BATCH_SIZE=50

# Provider configuration.
CODEX_BINARY=/usr/local/bin/codex
CODEX_USAGE_ENDPOINT=https://chatgpt.com/backend-api/wham/usage
CODEX_AUTH_ENROLLMENT_TTL_SECONDS=900
CODEX_AUTH_STALE_AFTER_SECONDS=691200
CODEX_APP_SERVER_TIMEOUT_SECONDS=30.0
ENABLE_PROVIDER_CODEX=true
ENABLE_PROVIDER_CLAUDE_CODE=false
ENABLE_PROVIDER_GEMINI_CLI=false

# Client assets and optional local preview protection.
MINIAPP_STATIC_ROOT=/opt/ai-session-control-center/frontend/telegram-miniapp
CUS_PREVIEW_TOKEN=

# Compatibility settings used by the transitional project/session API only.
# Runtime V1 does not import or patch the Telegram Agent source tree.
TELEGRAM_BOT_TOKEN=
TELEGRAM_AI_AGENT_ROOT=/opt/telegram-ai-agent
TELEGRAM_AI_AGENT_TOPIC_CONFIG_PATH=/var/lib/telegram-ai-agent/topic_config.json
TELEGRAM_AI_AGENT_TMUX_STATE_PATH=/var/lib/telegram-ai-agent/tmux_sessions/state.json
TELEGRAM_AI_AGENT_COMPATIBILITY_MANIFEST=/etc/ai-session-control-center/compatibility.json
TELEGRAM_AI_AGENT_CONTROL_SOCKET=/run/user/1000/telegram-ai-agent-control.sock
