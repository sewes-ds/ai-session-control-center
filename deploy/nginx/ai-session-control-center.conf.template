server {
    listen 80;
    listen [::]:80;
    server_name __CUS_HOST__;
    access_log off;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 308 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __CUS_HOST__;
    access_log off;

    ssl_certificate /etc/letsencrypt/live/__CUS_HOST__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__CUS_HOST__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:CUS_TLS:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;

    client_max_body_size 10m;

    location = / {
        return 302 __CUS_BASE_PATH__/;
    }

    location = __CUS_BASE_PATH__ {
        return 308 __CUS_BASE_PATH__/;
    }

    location = __CUS_BASE_PATH__/health {
        proxy_pass http://127.0.0.1:8710/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location = __CUS_BASE_PATH__/api {
        proxy_pass http://127.0.0.1:8710/api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Prefix __CUS_BASE_PATH__;
        proxy_read_timeout 120s;
    }

    location ^~ __CUS_BASE_PATH__/api/ {
        proxy_pass http://127.0.0.1:8710/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Prefix __CUS_BASE_PATH__;
        proxy_read_timeout 120s;
    }

    location ^~ __CUS_BASE_PATH__/ {
        proxy_pass http://127.0.0.1:8710/miniapp/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Prefix __CUS_BASE_PATH__;
        proxy_read_timeout 120s;
    }

    location / {
        return 404;
    }
}
